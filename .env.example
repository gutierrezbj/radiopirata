# Puerto de la API (y de la web en producción, que se sirve desde el mismo proceso).
PORT=3001

# Ruta al build de la web que sirve el servidor en producción. Relativa a server/.
WEB_DIST=../web/dist

# Identificador enviado a Radio Browser en la cabecera User-Agent. Su documentación pide
# que sea descriptivo y permita identificar la aplicación.
RADIO_BROWSER_USER_AGENT=RadioPirata/0.1 (+https://github.com/gutierrezbj/radiopirata)

# Tiempo máximo por petición a Radio Browser, en milisegundos.
RADIO_BROWSER_TIMEOUT_MS=6000

# Vida de la caché de consultas, en milisegundos (15 minutos).
CACHE_TTL_MS=900000

# Máximo de entradas en caché.
CACHE_MAX=200

# Cuántos proxies de confianza hay por delante. Con nginx o Caddy delante, 1. Sin proxy, 0.
TRUST_PROXY=0

# Cabecera HSTS. Activar SOLO cuando el dominio ya sirva HTTPS correctamente: si se activa antes,
# los navegadores recordarán la obligación de usar HTTPS y no podrán entrar por http.
HSTS=0

# Este archivo no contiene secretos y no los necesita: RadioPirata no usa claves ni cuentas.
